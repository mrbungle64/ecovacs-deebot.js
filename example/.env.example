# Ecovacs/Yeedi Configuration

# Your Ecovacs ID (email or phone)
ECOVACS_ACCOUNT_ID=email@domain.com

# Your password
ECOVACS_PASSWORD=your_password

# Two-letter country code (e.g., DE, US, FR)
ECOVACS_COUNTRY_CODE=DE

# Device index (0 for the first device in your account)
ECOVACS_DEVICE_NUMBER=0

# Fixed client device id. Set a stable value to avoid repeated device verification (see below).
# When empty, it is derived from the host machine id
ECOVACS_CLIENT_DEVICE_ID=

# Auth domain (optional)
# Leave blank for Ecovacs. Use 'yeedi.com' for Yeedi devices.
ECOVACS_AUTH_DOMAIN=
